# Environment variables for Vercel (locally the API also reads the git-ignored files atlas_user.txt, atlas_password.txt, gemini_key.txt)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.kkky9y1.mongodb.net/
GEMINI_API_KEY=
DEMO_KEY=            # protects /api/demo-closure
STREAM_PROCESSING=off   # 'on' once the Atlas stream processor writes alerts
