{
  "name": "closures_to_alerts",
  "pipeline": [
    { "$source": { "connectionName": "deadspot", "db": "deadspot", "coll": "closure_events" } },
    { "$match": { "operationType": "insert" } },
    { "$replaceRoot": { "newRoot": "$fullDocument" } },
    { "$lookup": {
        "from": { "connectionName": "deadspot", "db": "deadspot", "coll": "cases" },
        "let": {
          "lng": { "$arrayElemAt": ["$location.coordinates", 0] },
          "lat": { "$arrayElemAt": ["$location.coordinates", 1] }
        },
        "pipeline": [
          { "$project": { "_id": 0, "id": 1, "address": 1,
              "distance_m": { "$sqrt": { "$add": [
                { "$pow": [{ "$multiply": [{ "$subtract": [{ "$arrayElemAt": ["$location.coordinates", 1] }, "$$lat"] }, 111320] }, 2] },
                { "$pow": [{ "$multiply": [
                    { "$subtract": [{ "$arrayElemAt": ["$location.coordinates", 0] }, "$$lng"] }, 111320,
                    { "$cos": { "$degreesToRadians": { "$arrayElemAt": ["$location.coordinates", 1] } } } ] }, 2] } ] } } } },
          { "$match": { "distance_m": { "$lte": 150 } } }
        ],
        "as": "near" } },
    { "$unwind": "$near" },
    { "$project": {
        "_id": { "$concat": [{ "$toString": "$_id" }, ":", { "$toString": "$near.id" }] },
        "case_id": "$near.id",
        "address": "$near.address",
        "distance_m": { "$round": ["$near.distance_m", 0] },
        "event": { "company_name": "$company_name", "address": "$address", "location": "$location", "dissolved_at": "$dissolved_at" },
        "processed_by": { "$literal": "atlas-stream-processing" },
        "at": { "$currentDate": {} } } },
    { "$merge": {
        "into": { "connectionName": "deadspot", "db": "deadspot", "coll": "alerts" },
        "on": "_id",
        "whenMatched": "keepExisting",
        "whenNotMatched": "insert" } }
  ]
}
